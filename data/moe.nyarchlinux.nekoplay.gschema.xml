<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="cine">
	<enum id="moe.nyarchlinux.nekoplay.LoopState">
		<value nick="off" value="0" />
		<value nick="playlist" value="1" />
		<value nick="file" value="2" />
	</enum>
	<schema id="moe.nyarchlinux.nekoplay" path="/moe/nyarchlinux/nekoplay/">
		<key name="open-new-windows" type="b">
			<default>true</default>
		</key>
		<key name="normalize-volume" type="b">
			<default>false</default>
		</key>
		<key name="subtitle-font" type="s">
			<default>"Adwaita Sans SemiBold"</default>
		</key>
		<key name="subtitle-scale" type="d">
			<default>1</default>
		</key>
		<key name="subtitle-languages" type="s">
			<default>""</default>
		</key>
		<key name="audio-languages" type="s">
			<default>""</default>
		</key>
		<key name="graphics-offload" type="b">
			<default>false</default>
		</key>
		<key name="hwdec" type="b">
			<default>false</default>
		</key>
		<key name="save-video-position" type="b">
			<default>false</default>
		</key>
		<key name="subtitle-color" type="s">
			<default>"#ebebeb"</default>
		</key>
		<key name="subtitle-bg" type="b">
			<default>false</default>
		</key>
		<key name="subtitle-bg-color" type="s">
			<default>"#97000000"</default>
		</key>
		<key name="volume" type="i">
			<default>100</default>
		</key>
		<key name="show-remaining" type="b">
			<default>false</default>
		</key>
		<key name="thumbnail-preview" type="b">
			<default>false</default>
		</key>
		<key name="save-session" type="b">
			<default>false</default>
		</key>
		<key name="is-maximized" type="b">
			<default>false</default>
		</key>
		<key name="left-click" type="i">
			<default>2</default>
		</key>
		<key name="right-click" type="i">
			<default>0</default>
		</key>
		<key name="loop-state" enum="moe.nyarchlinux.nekoplay.LoopState">
			<default>'off'</default>
		</key>
		<key name="anime4k-mode" type="s">
			<default>"off"</default>
		</key>
		<key name="video2x-path" type="s">
			<default>""</default>
			<summary>Folder holding video2x_optimized</summary>
		</key>
		<key name="video2x-mode" type="s">
			<default>"off"</default>
			<summary>off, upscale, interp2 or interp4</summary>
		</key>
		<key name="video2x-render" type="s">
			<default>"pre"</default>
			<summary>pre: render the whole file first; live: play while it renders</summary>
		</key>
		<key name="video2x-cache-limit" type="i">
			<default>10</default>
			<range min="1" max="2000"/>
			<summary>Most the rendered-video cache may hold, in GB; the oldest renders go first</summary>
		</key>
	</schema>
</schemalist>
